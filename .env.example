ANTHROPIC_API_KEY=your-anthropic-api-key-here

# GitHub repo for Standards Indexer (learns patterns from merged PRs)
GITHUB_REPO=owner/repo-name

# GitHub token is only needed for Standards Indexer (PyGithub).
# The `preflight pr` command uses gh CLI which handles its own auth.
# PREFLIGHT_GITHUB_TOKEN=github_pat_...
